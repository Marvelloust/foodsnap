PORT=3050
NODE_ENV=local
APP_ORIGIN=http://localhost:3050
SESSION_SECRET=replace-with-a-long-random-value

# Combined vision/OCR provider. Receives the normalized request documented in docs/AI_PROVIDERS.md.
FOODSNAP_VISION_ENDPOINT=
FOODSNAP_VISION_TOKEN=

# Optional conversational provider for open-ended Ask FoodSnap questions.
FOODSNAP_ASSISTANT_ENDPOINT=
FOODSNAP_ASSISTANT_TOKEN=

# Optional transactional mail webhook for password recovery. Receives JSON {to,subject,text,html}.
FOODSNAP_MAIL_ENDPOINT=
FOODSNAP_MAIL_TOKEN=

# Optional bootstrap administrator. Created only if the email does not already exist.
FOODSNAP_ADMIN_EMAIL=
FOODSNAP_ADMIN_PASSWORD=
FOODSNAP_ADMIN_NAME=FoodSnap Admin
FOODSNAP_ADMIN_USERNAME=foodsnap-admin

# Optional direct OpenAI adapter retained from the second FoodSnap branch.
# Used when FOODSNAP_VISION_ENDPOINT / FOODSNAP_ASSISTANT_ENDPOINT are not set.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna

# Direct Google Gemini alternative. Used when custom providers and OpenAI are not configured.
# Gemini free-tier availability/limits depend on your Google AI Studio account and selected model.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_ASSISTANT_MODEL=gemini-3.1-flash-lite

# Direct transactional email providers. Configure ONE of these or FOODSNAP_MAIL_ENDPOINT.
# Resend: https://resend.com — use a verified sender/domain for real inbox delivery.
RESEND_API_KEY=
# Brevo: https://brevo.com — transactional email API also supported.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FoodSnap
FOODSNAP_FROM_EMAIL=
FOODSNAP_FROM_NAME=FoodSnap

# Optional per-user daily analysis unit limit. Multi-image scans consume multiple units.
FOODSNAP_DAILY_AI_LIMIT=40

# Optional database/runtime paths and deterministic Data Lab seed.
FOODSNAP_DB=
FOODSNAP_SEED=20260911

# Optional external media processor. Receives newly uploaded image/video metadata and can
# return poster frames, dimensions, duration and responsive variants.
FOODSNAP_MEDIA_ENDPOINT=
FOODSNAP_MEDIA_TOKEN=

# Optional browser-push gateway. Push subscriptions are still persisted when configured.
FOODSNAP_PUSH_ENDPOINT=
FOODSNAP_PUSH_TOKEN=
FOODSNAP_PUSH_PUBLIC_KEY=

# Optional custom barcode resolver. If empty, FoodSnap falls back to OpenFoodFacts.
FOODSNAP_BARCODE_ENDPOINT=

# Production process controls. Run `npm run worker` as a separate process for scheduled jobs.
FOODSNAP_RUN_JOBS=
FOODSNAP_TRUST_PROXY=0
